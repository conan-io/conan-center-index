Custom: Honor msvc runtime from Conan profile

diff --git a/CMakeLists.txt b/CMakeLists.txt
index dfc23fb..bc507cf 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -105,14 +105,6 @@ if(NOT IDF_TARGET)
         add_compile_options(/W3)
 
         # Specify proper C runtime library:
