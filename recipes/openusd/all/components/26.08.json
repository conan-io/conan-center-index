{
    "ar": {
        "requires": ["arch", "js", "tf", "plug", "vt", "onetbb::libtbb"]
    },
    "arch": {
        "requires": []
    },
    "cameraUtil": {
        "condition": ["with_imaging"],
        "requires": ["tf", "gf"]
    },
    "ef": {
        "requires": ["vdf", "arch", "tf", "trace", "usd", "work", "onetbb::libtbb"]
    },
    "esf": {
        "requires": ["arch", "sdf", "tf", "vt", "usd"]
    },
    "esfUsd": {
        "requires": ["arch", "esf", "tf", "sdf", "usd"]
    },
    "exec": {
        "requires": ["ef", "esf", "tf", "trace", "ts", "sdf", "usd", "vdf", "vt", "onetbb::libtbb"]
    },
    "execGeom": {
        "requires": ["gf", "tf", "execUsd", "usdGeom"]
    },
    "execIr": {
        "requires": ["execGeom", "execUsd", "gf", "sdf", "tf", "usd", "vt"]
    },
    "execUsd": {
        "requires": ["esf", "esfUsd", "exec", "tf", "trace", "sdf", "usd"]
    },
    "garch": {
        "condition": ["with_imaging"],
        "frameworks": ["Foundation", "$kit_framework"],
        "requires": ["arch", "tf", "opengl::opengl"]
    },
    "geomUtil": {
        "condition": ["with_imaging"],
        "requires": ["arch", "gf", "tf", "vt", "pxOsd"]
    },
    "gf": {
        "requires": ["arch", "tf"]
    },
    "glf": {
        "condition": ["with_imaging"],
        "requires": ["ar", "arch", "garch", "gf", "hf", "hio", "plug", "tf", "trace", "sdf"]
    },
    "hd": {
        "condition": ["with_imaging"],
        "requires": ["plug", "tf", "trace", "vt", "work", "sdf", "cameraUtil", "hf", "pxOsd", "sdr", "onetbb::libtbb"]
    },
    "hdGp": {
        "condition": ["with_imaging"],
        "requires": ["hd", "hf", "onetbb::libtbb"]
    },
    "hdMtlx": {
        "condition": ["with_imaging", "with_materialx"],
        "requires": ["gf", "hd", "sdf", "sdr", "tf", "trace", "usdMtlx", "vt", "materialx::MaterialXCore", "materialx::MaterialXFormat"]
    },
    "hdSt": {
        "condition": ["with_imaging"],
        "conditional": [
            {
                "condition": ["with_materialx"],
                "requires": ["materialx::MaterialXGenShader", "materialx::MaterialXRender", "materialx::MaterialXCore", "materialx::MaterialXFormat", "materialx::MaterialXGenGlsl", "hdMtlx"]
            },
            {
                "condition": ["is_apple", "with_materialx"],
                "requires": ["materialx::MaterialXGenMsl"]
            }
        ],
        "requires": ["hio", "garch", "glf", "hd", "hdsi", "hgiGL", "hgiInterop", "sdr", "tf", "trace", "onetbb::libtbb", "opensubdiv::osdcpu", "opensubdiv::osdgpu"]
    },
    "hdStorm": {
        "condition": ["with_imaging"],
        "is_plugin": true,
        "requires": ["plug", "tf", "trace", "vt", "work", "hd", "hdSt", "opensubdiv::osdcpu", "opensubdiv::osdgpu"]
    },
    "hdar": {
        "condition": ["with_imaging"],
        "requires": ["hd", "ar"]
    },
    "hdsi": {
        "condition": ["with_imaging"],
        "requires": ["plug", "tf", "trace", "vt", "work", "sdf", "cameraUtil", "usdShade", "usdVol", "geomUtil", "hf", "hd", "pxOsd", "onetbb::libtbb"]
    },
    "hdx": {
        "condition": ["with_imaging"],
        "requires": ["plug", "tf", "vt", "gf", "work", "garch", "glf", "pxOsd", "hd", "hdSt", "hgi", "hgiInterop", "cameraUtil", "sdf"]
    },
    "hf": {
        "condition": ["with_imaging"],
        "requires": ["plug", "tf", "trace"]
    },
    "hgi": {
        "condition": ["with_imaging"],
        "requires": ["gf", "plug", "tf", "hio"]
    },
    "hgiGL": {
        "condition": ["with_imaging"],
        "requires": ["arch", "garch", "hf", "hgi", "tf", "trace"]
    },
    "hgiInterop": {
        "condition": ["with_imaging"],
        "conditional": [
            {
                "condition": ["is_apple"],
                "frameworks": ["Foundation", "CoreVideo"],
                "requires": ["hgiMetal"]
            }
        ],
        "requires": ["gf", "tf", "hgi", "vt", "garch"]
    },
    "hgiMetal": {
        "condition": ["is_apple", "with_imaging"],
        "frameworks": ["Foundation", "Metal", "AppKit"],
        "requires": ["arch", "hgi", "tf", "trace"]
