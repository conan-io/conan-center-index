        "condition": ["with_imaging", "with_materialx"],
        "requires": ["tf", "sdr", "usdMtlx", "usdShade", "hd", "hdMtlx", "usdImaging", "materialx::MaterialXCore", "materialx::MaterialXFormat", "materialx::MaterialXRenderGlsl"]
    },
    "usdExecImaging": {
        "condition": ["with_imaging"],
        "requires": ["execGeom", "execIr", "execUsd", "hd", "sdf", "tf", "trace", "usd", "usdGeom", "vt"]
    },
    "usdGeom": {
        "requires": ["js", "tf", "plug", "vt", "sdf", "trace", "usd", "work", "onetbb::libtbb"]
    },
    "usdGeomValidators": {
        "requires": ["tf", "plug", "sdf", "usd", "usdGeom", "usdValidation"]
    },
    "usdHydra": {
        "requires": ["tf", "usd", "usdShade"]
    },
    "usdImaging": {
        "condition": ["with_imaging"],
        "requires": ["gf", "tf", "plug", "trace", "vt", "work", "geomUtil", "hd", "hdar", "hdsi", "hio", "pxOsd", "sdf", "usd", "usdGeom", "usdLux", "usdRender", "usdShade", "usdSkel", "usdVol", "ar", "onetbb::libtbb"]
    },
    "usdImagingGL": {
        "condition": ["with_imaging"],
        "requires": ["gf", "tf", "plug", "trace", "vt", "work", "hio", "garch", "glf", "hd", "hdsi", "hdx", "pxOsd", "sdf", "sdr", "usd", "usdGeom", "usdHydra", "usdShade", "usdImaging", "usdExecImaging", "ar"]
    },
    "usdIrImaging": {
        "condition": ["with_imaging"],
        "requires": ["execIr", "gf", "hd", "tf", "usd", "usdGeom", "usdImaging"]
    },
    "usdLod": {
        "requires": ["tf", "gf", "vt", "sdf", "usd", "usdGeom"]
    },
