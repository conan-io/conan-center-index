if(MSVC AND TARGET units::units)
    get_filename_component(_units_natvis "${CMAKE_CURRENT_LIST_DIR}/../../share/units/natvis/units.natvis" ABSOLUTE)
    get_target_property(_units_sources units::units INTERFACE_SOURCES)
    if(NOT _units_natvis IN_LIST _units_sources)
        target_sources(units::units INTERFACE "${_units_natvis}")
    endif()
    unset(_units_sources)
    unset(_units_natvis)
endif()
