diff --git a/src/frontends/onnx/onnx_common/CMakeLists.txt b/src/frontends/onnx/onnx_common/CMakeLists.txt
index 8b3c00f0..89e12a96 100644
--- a/src/frontends/onnx/onnx_common/CMakeLists.txt
+++ b/src/frontends/onnx/onnx_common/CMakeLists.txt
@@ -30,7 +30,14 @@ target_include_directories(${TARGET_NAME}
 
 target_link_libraries(${TARGET_NAME} PRIVATE openvino::runtime openvino::util)
 
-ov_link_system_libraries(${TARGET_NAME} PUBLIC onnx_proto onnx)
+# Do not link onnx_proto separately alongside onnx.
+# The onnx cmake build compiles ONNX_PROTO_SRCS into *both* libonnx and
+# libonnx_proto (see onnx/CMakeLists.txt). When both are built as shared
+# libraries, each dylib registers onnx/onnx-ml.proto descriptors independently.
+# Loading both in the same process causes a duplicate-registration SIGABRT.
+# libonnx already exposes every symbol from libonnx_proto, so the separate
+# onnx_proto link entry is redundant and must be removed for shared builds.
+ov_link_system_libraries(${TARGET_NAME} PUBLIC onnx)
 
 ov_add_clang_format_target(${TARGET_NAME}_clang FOR_TARGETS ${TARGET_NAME})
 
diff --git a/thirdparty/dependencies.cmake b/thirdparty/dependencies.cmake
index 5e1073d8..9c7f7f10 100644
--- a/thirdparty/dependencies.cmake
+++ b/thirdparty/dependencies.cmake
@@ -74,14 +74,7 @@ endif()
 
 if(ENABLE_OV_ZERO_LOADER)
     if(ENABLE_SYSTEM_LEVEL_ZERO)
-        pkg_search_module(level_zero QUIET
-                          IMPORTED_TARGET
-                          ${OV_PkgConfig_VISIBILITY}
-                          level-zero)
-        if(level_zero_FOUND)
-            add_library(LevelZero::LevelZero ALIAS PkgConfig::level_zero)
-            message(STATUS "${PKG_CONFIG_EXECUTABLE}: level_zero (${level_zero_VERSION}) is found at ${level_zero_PREFIX}")
-        endif()
+        find_package(level-zero)
     endif()
 
     if(NOT level_zero_FOUND)
@@ -564,10 +557,10 @@ if(ENABLE_OV_ONNX_FRONTEND)
     if(ONNX_FOUND)
         # conan and vcpkg create imported targets 'onnx' and 'onnx_proto'
         # newer versions of ONNX in vcpkg has ONNX:: prefix, let's create aliases
-        if(TARGET ONNX::onnx)
+        if(TARGET ONNX::onnx AND NOT TARGET onnx)
             add_library(onnx ALIAS ONNX::onnx)
         endif()
-        if(TARGET ONNX::onnx_proto)
+        if(TARGET ONNX::onnx_proto AND NOT TARGET onnx_proto)
             add_library(onnx_proto ALIAS ONNX::onnx_proto)
         endif()
     else()
