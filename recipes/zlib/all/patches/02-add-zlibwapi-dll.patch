Add a zlibwapi.dll target to the contrib/zlib1-dll sub-project:
- Up to 1.3.1, the pre-generated Visual Studio solution (contrib/vstudio/zlibvc.sln)
  produced zlibwapi.dll: zlib plus contrib/minizip, built with ZLIB_WINAPI so that
  the exported functions use the WINAPI (stdcall) calling convention. That solution
  was removed in 1.3.2 and the CMake build has no replacement for it
- Some consumers link against, or LoadLibrary(), that specific filename and ABI
- 1.3.2 already ships contrib/zlib1-dll and the ZLIB_BUILD_ZLIB1_DLL option, but
  the sub-project only builds zlib1.dll

Upstream added the same DLL to the same sub-project after the 1.3.2 release
(madler/zlib@337803ad, plus @160de9bf for the version resource), so this patch is
expected to be dropped at the next zlib release. It is deliberately not a literal
backport of those two commits: they sit on top of eight further changes to the
sub-project - target-name prefixes, a CMake package export, cmake_path() and a
3.20 minimum, a debug postfix, standalone-vs-chainbuild path handling - none of
which have anything to do with zlibwapi. Only what creates the DLL is carried here.

Three changes to contrib/zlib1-dll/CMakeLists.txt:
- win32/zlib1.rc moves out of the shared source list onto the zlib1 target. A
  version resource hardcodes InternalName/OriginalFilename, so each DLL needs its
  own, otherwise zlibwapi.dll reports itself as zlib1.dll. Upstream hit the same
  problem in 160de9bf
- the zlibwapi target, a copy of the zlib1 target with ZLIB_WINAPI added to its
  PUBLIC compile definitions. It has to be PUBLIC: consumers must be compiled with
  it too, or the prototypes in zlib.h and in the minizip headers use a different
  calling convention than the library (see win32/DLL_FAQ.txt, section 7)
- the install() calls become conditional on a new ZLIB1_DLL_INSTALL option, which
  is the name upstream later chose for it. Building this sub-project from within
  zlib otherwise installs a second zlib1.dll over the one the main build produced,
  and copies the minizip headers into the include root

contrib/zlib1-dll/zlibwapi.rc is win32/zlib1.rc with the include path adjusted for
its new location and both filename fields changed to zlibwapi.dll.

Upstream does not compile contrib/minizip/iowin32.c into the DLL, so the
fill_win32_filefunc* entry points of the historic www.winimage.com/zLibDll build
are absent here as well. Everything else that one exported is present.

diff --git a/contrib/zlib1-dll/CMakeLists.txt b/contrib/zlib1-dll/CMakeLists.txt
index 8662512..59af502 100644
--- a/contrib/zlib1-dll/CMakeLists.txt
+++ b/contrib/zlib1-dll/CMakeLists.txt
@@ -16,6 +16,7 @@ if(NOT WIN32)
 endif(NOT WIN32)
 
 option(ENABLE_BZIP2 "Build with bzip2 support" OFF)
+option(ZLIB1_DLL_INSTALL "Install zlib1.dll and zlibwapi.dll" ON)
 set(CMAKE_WINDOWS_EXPORT_ALL_SYMBOLS TRUE)
 
 include(CheckCSourceCompiles)
@@ -142,7 +143,6 @@ set(ZLIB1-DLL_SRCS
     ../../inffast.c
     ../../trees.c
     ../../uncompr.c
-    ../../win32/zlib1.rc
     ../../zutil.c
     ../minizip/ioapi.c
     ../minizip/mztools.c
@@ -151,7 +151,8 @@ set(ZLIB1-DLL_SRCS
 
 add_library(zlib1 SHARED ${ZLIB1-DLL_SRCS}
                          ${ZLIB1-DLL_PUBLIC_HDRS}
-                         ${ZLIB1-DLL_PRIVATE_HDRS})
+                         ${ZLIB1-DLL_PRIVATE_HDRS}
+                         ../../win32/zlib1.rc)
 
 #taget_include_directories doesn't like relative paths
 include_directories(../../
@@ -181,16 +182,53 @@ endif(NOT CYGWIN)
 set_target_properties(zlib1 PROPERTIES
     DEFINE_SYMBOL ZLIB_DLL)
 
-install(
-    TARGETS zlib1
-    ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}"
-    RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}"
-    LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}")
+# ============================================================================
+# zlibwapi-dll
+# ============================================================================
+# Same library, built for the WINAPI (stdcall) calling convention: ZLIB_WINAPI
+# makes zconf.h define ZEXPORT as WINAPI. It is PUBLIC because consumers have to
+# be compiled with it as well, see win32/DLL_FAQ.txt.
+add_library(zlibwapi SHARED ${ZLIB1-DLL_SRCS}
+                            ${ZLIB1-DLL_PUBLIC_HDRS}
+                            ${ZLIB1-DLL_PRIVATE_HDRS}
+                            zlibwapi.rc)
+
+target_compile_definitions(zlibwapi
+    PRIVATE ZLIB_BUILD
+            $<$<BOOL:NOT:${HAVE_FSEEKO}>:NO_FSEEKO>
+            $<$<BOOL:${HAVE_UNISTD_H}>:HAVE_UNISTD_H=1>
+            $<$<BOOL:${HAVE___ATTR__VIS_HIDDEN}>:HAVE_HIDDEN>
+            $<$<BOOL:${MSVC}>:_CRT_SECURE_NO_DEPRECATE>
+            $<$<BOOL:${MSVC}>:_CRT_NONSTDC_NO_DEPRECATE>
+    PUBLIC $<$<BOOL:${HAVE_OFF64_T}>:_LARGEFILE64_SOURCE=1>
+           $<$<BOOL:${BZIP2_FOUND}>:HAVE_BZIP2=1>
+           $<$<BOOL:NOT:${HAVE_FOPEN64}>:USE_FILE32API=1>
+           ZLIB_WINAPI)
+
+target_link_libraries(zlibwapi
+    PUBLIC $<$<BOOL:${BZIP2_FOUND}>:BZip2::BZip2>)
 
-install(
-    FILES ${ZLIB1-DLL_PUBLIC_HDRS}
-    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}")
+if(NOT CYGWIN)
+    set_target_properties(zlibwapi PROPERTIES
+        SOVERSION ${zlib1-dll_VERSION_MAJOR}
+        VERSION ${zlib1-dll_VERSION})
+endif(NOT CYGWIN)
+
+set_target_properties(zlibwapi PROPERTIES
+    DEFINE_SYMBOL ZLIB_DLL)
 
-install(
-    FILES ../../LICENSE
-    DESTINATION "${CMAKE_INSTALL_DOCDIR}/zlib1-dll")
+if(ZLIB1_DLL_INSTALL)
+    install(
+        TARGETS zlib1 zlibwapi
+        ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}"
+        RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}"
+        LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}")
+
+    install(
+        FILES ${ZLIB1-DLL_PUBLIC_HDRS}
+        DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}")
+
+    install(
+        FILES ../../LICENSE
+        DESTINATION "${CMAKE_INSTALL_DOCDIR}/zlib1-dll")
+endif(ZLIB1_DLL_INSTALL)
