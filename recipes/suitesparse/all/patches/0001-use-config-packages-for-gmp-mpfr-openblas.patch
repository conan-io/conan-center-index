--- a/SuiteSparse_config/cmake_modules/SuiteSparseBLAS.cmake
+++ b/SuiteSparse_config/cmake_modules/SuiteSparseBLAS.cmake
@@ -60,6 +60,16 @@
 # dynamic/static linking with BLAS
 option ( BLA_STATIC
     "OFF (default): dynamic linking of BLAS.  ON: static linking of BLAS" OFF )
+
+if ( BLA_VENDOR STREQUAL "OpenBLAS" AND NOT DEFINED BLAS_LIBRARIES )
+    find_package ( OpenBLAS CONFIG REQUIRED )
+    set ( BLAS_LIBRARIES OpenBLAS::OpenBLAS )
+    set ( BLAS_INCLUDE_DIRS ${OpenBLAS_INCLUDE_DIRS} )
+    set ( LAPACK_LIBRARIES OpenBLAS::OpenBLAS )
+    if ( CMAKE_BUILD_TYPE )
+        set ( CMAKE_TRY_COMPILE_CONFIGURATION ${CMAKE_BUILD_TYPE} )
+    endif ( )
+endif ( )
 
 if ( DEFINED BLAS_LIBRARIES OR DEFINED BLAS_INCLUDE_DIRS )
     # User supplied variables for libraries and/or include directories.
